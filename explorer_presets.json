  "analysis_presets": [
    {
      "id": "low-powell-wy-outflow",
      "name": "Low Powell WY Outflow",
      "description": "Example: traces whose Powell.Outflow water-year sum is below 7,000,000, returning Powell pool elevation.",
      "settings": {
        "run": "current",
        "match_mode": "same_period",
        "logic": "all",
        "return_period": "all",
        "conditions": [
          {
            "slot": "Powell.Outflow",
            "calculation": "water_sum",
            "op": "<",
            "value": "7000000",
            "value2": "",
            "month": "0",
            "year_basis": "water",
            "years": "2024"
          }
        ],
        "return_slots": [
          "Powell.Pool Elevation"
        ]
      }
    }
